---
slug: api/mobile/reset-password
format: json
method: post
searchable: false
metadata: {
    page_name: "API | Mobile | Reset Password",
}
---
{%- assign email = context.params.email | downcase | strip -%}
{%- assign token = context.params.token -%}
{%- assign new_password = context.params.new_password -%}

{%- comment -%} ── Step 1: Validate required fields ── {%- endcomment -%}
{%- if email == blank or token == blank or new_password == blank -%}
  {%- assign response = '{}' | parse_json -%}
  {%- assign response = response | add_hash_key: "success", false -%}
  {%- assign response = response | add_hash_key: "error", "Email, token, and new password are required." -%}
  {{ response }}
{%- else -%}

  {%- comment -%} ── Step 2: Look up user and stored password token ── {%- endcomment -%}
  {%- graphql user_data = "modules/portal/account/get_user_with_password_token", email: email -%}
  {%- assign user = user_data | dig: "users", "results" | first -%}
  {%- assign token_profile = user.default | first -%}

  {%- comment -%} ── Step 3: Validate token (3 checks, matching web portal pattern) ── {%- endcomment -%}
  {%- assign token_valid = token | is_token_valid: user.id -%}

  {%- if user.id == blank or token_valid == false or token_profile.password_token != token -%}
    {%- assign response = '{}' | parse_json -%}
    {%- assign response = response | add_hash_key: "success", false -%}
    {%- assign response = response | add_hash_key: "error", "Invalid or expired reset link. Please request a new one." -%}
    {{ response }}
  {%- else -%}

    {%- comment -%} ── Step 4: Update password ── {%- endcomment -%}
    {%- graphql update_result = "modules/website/mobile/change_password",
        id: user.id,
        password: new_password -%}
    {%- assign updated_user = update_result.user_update -%}

    {%- if updated_user == blank -%}
      {%- assign response = '{}' | parse_json -%}
      {%- assign response = response | add_hash_key: "success", false -%}
      {%- assign response = response | add_hash_key: "error", "Failed to reset password. Please try again." -%}
      {{ response }}
    {%- else -%}

      {%- comment -%} ── Step 5: Clear the password token (one-time use) ── {%- endcomment -%}
      {%- graphql clear_token = "modules/website/mobile/update_mobile_password_token",
          id: user.id,
          token: "" -%}

      {%- assign response = '{}' | parse_json -%}
      {%- assign response = response | add_hash_key: "success", true -%}
      {%- assign response = response | add_hash_key: "message", "Password has been reset successfully. Please log in with your new password." -%}
      {{ response }}

    {%- endif -%}
  {%- endif -%}
{%- endif -%}
