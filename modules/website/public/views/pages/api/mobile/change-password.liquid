---
slug: api/mobile/change-password
format: json
method: post
searchable: false
metadata: {
    page_name: "API | Mobile | Change Password",
}
---
{%- assign token = context.params.token -%}
{%- assign new_password = context.params.new_password -%}

{%- comment -%} ── Step 1: Validate required fields ── {%- endcomment -%}
{%- if token == blank or new_password == blank -%}
  {%- assign response = '{}' | parse_json -%}
  {%- assign response = response | add_hash_key: "success", false -%}
  {%- assign response = response | add_hash_key: "error", "Token and new password are required." -%}
  {{ response }}
{%- else -%}

  {%- comment -%} ── Step 2: Decode JWT to get user identity ── {%- endcomment -%}
  {%- graphql session_result = "modules/website/mobile/jwt_decode_and_set_session", token: token -%}
  {%- assign session_user = session_result.jwt_decode_and_set_session -%}

  {%- if session_user == blank -%}
    {%- assign response = '{}' | parse_json -%}
    {%- assign response = response | add_hash_key: "success", false -%}
    {%- assign response = response | add_hash_key: "error", "Invalid or expired token." -%}
    {{ response }}
  {%- else -%}

    {%- comment -%} ── Step 3: Update password ── {%- endcomment -%}
    {%- graphql update_result = "modules/website/mobile/change_password",
        id: session_user.id,
        password: new_password -%}
    {%- assign updated_user = update_result.user_update -%}

    {%- if updated_user == blank -%}
      {%- assign response = '{}' | parse_json -%}
      {%- assign response = response | add_hash_key: "success", false -%}
      {%- assign response = response | add_hash_key: "error", "Failed to change password. Please try again." -%}
      {{ response }}
    {%- else -%}

      {%- comment -%} ── Step 4: Destroy session (auto sign-out) ── {%- endcomment -%}
      {%- graphql sign_out = "modules/portal/session/delete_current_session" -%}

      {%- assign response = '{}' | parse_json -%}
      {%- assign response = response | add_hash_key: "success", true -%}
      {%- assign response = response | add_hash_key: "message", "Password changed successfully. Please log in again." -%}
      {{ response }}

    {%- endif -%}
  {%- endif -%}
{%- endif -%}
