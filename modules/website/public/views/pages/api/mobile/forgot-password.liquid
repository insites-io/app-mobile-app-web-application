---
slug: api/mobile/forgot-password
format: json
method: post
searchable: false
metadata: {
    page_name: "API | Mobile | Forgot Password",
}
---
{%- assign email = context.params.email | downcase | strip -%}

{%- if email == blank -%}
  {%- assign response = '{}' | parse_json -%}
  {%- assign response = response | add_hash_key: "success", false -%}
  {%- assign response = response | add_hash_key: "error", "Email is required." -%}
  {{ response }}
{%- else -%}

  {%- comment -%} ── Step 1: Generate 24-hour temporary token (also confirms user exists) ── {%- endcomment -%}
  {%- graphql generated_token = "modules/portal/account/generate_user_temporary_token", email: email -%}
  {%- assign token_user = generated_token | dig: "items", "results" | first -%}

  {%- if token_user != blank -%}

    {%- comment -%} ── Step 2: Store the token in the user's token profile ── {%- endcomment -%}
    {%- graphql store_token = "modules/website/mobile/update_mobile_password_token",
        id: token_user.id,
        token: token_user.temporary_token -%}

    {%- comment -%} ── Step 3: Fetch user details for email greeting ── {%- endcomment -%}
    {%- graphql user_data = "modules/portal/account/get_user_by_email", email: email -%}
    {%- assign user_info = user_data | dig: "items", "results" | first -%}

    {%- comment -%} ── Step 4: Send mobile password reset email ── {%- endcomment -%}
    {% parse_json email_data %}
    {
        "email": "{{ email }}",
        "first_name": "{{ user_info.first_name }}",
        "password_token": "{{ token_user.temporary_token }}"
    }
    {% endparse_json %}

    {%- graphql trigger = "modules/website/trigger_email_notification",
        name: "modules/portal/mobile_password_reset",
        data: email_data -%}

  {%- endif -%}

  {%- comment -%} ── Always return success (don't leak whether email exists) ── {%- endcomment -%}
  {%- assign response = '{}' | parse_json -%}
  {%- assign response = response | add_hash_key: "success", true -%}
  {%- assign response = response | add_hash_key: "message", "If an account exists with that email, a password reset link has been sent." -%}
  {{ response }}

{%- endif -%}
